# MetroGuard AI - .gitignore

# Python & Environment
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
.venv/
ENV/
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Testing & Linting
.pytest_cache/
.coverage
htmlcov/
.mypy_cache/

# Jupyter Notebooks
.ipynb_checkpoints/
*-checkpoint.ipynb

# Data and Raw files (Hard Rule: raw CSV must never be tracked or modified in git)
data/raw/
*.csv
!data/sample/*.csv
!data/processed/sample_*.csv

# Large Model weights (keep lightweight serialized artefacts or track via releases/DVC)
models/*.joblib
models/*.pkl
models/*.onnx
!models/.gitkeep

# IDE & OS
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db
